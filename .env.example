# Cobertura Integrada MSP — config example
# Copiar a .env y ajustar según el entorno

# Oracle RAC
ORACLE_TARGETS=172.16.60.21:1521:PRDSGH2

# Driver JDBC
ORACLE_JDBC_JAR=/ruta/completa/a/jdbc/ojdbc8.jar

# Proyecto Node con scripts/generate_pdf.js
COBERTURA_NODE_PROJECT_DIR=/home/crrb/codex_projects/cobertura_integrada
COBERTURA_OUTPUT_DIR=/ruta/donde/guardar/pdf
COBERTURA_NODE_BIN=node
# dibujado (por defecto): genera el PDF localmente con generate_pdf.js
# original: descarga el PDF original del portal con generate_pdf_original.js (requiere Chromium)
COBERTURA_PDF_MODE=dibujado
# Ruta al ejecutable de Chromium/Chrome si la versión de Playwright no coincide con el caché instalado
# CHROME_PATH=/home/USUARIO/.cache/ms-playwright/chromium_headless_shell-1243/chrome-headless-shell-linux64/chrome-headless-shell

# Login automático Oracle
ORACLE_AUTO_USER=DIGITALIZACION
ORACLE_AUTO_PASSWORD=DIGITALIZACION
AUTO_FE_PLA_ANIOMES_DESDE=202604
# En modo original reutiliza un solo Chromium entre consultas (mucho más rápido). 0 = abrir uno por consulta.
# COBERTURA_PDF_PERSISTENTE=1
